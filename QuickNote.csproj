<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>1.0.3</Version>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PublishDir>bin\Release\</PublishDir>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- Clean up intermediate build output after publish, keep only bin\Release\ -->
  <!-- 注意：框架依赖发布的 QuickNote.dll/deps.json/runtimeconfig.json 及 Hardcodet.dll 是运行必需文件，不能删除 -->
  <Target Name="CleanPublishIntermediate" AfterTargets="Publish">
    <RemoveDir Directories="bin\Release\net10.0-windows" />
  </Target>

</Project>
