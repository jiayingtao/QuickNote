<Window x:Class="QuickNote.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:QuickNote.Converters"
        Title="QuickNote"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MinWidth="280"
        MinHeight="300"
        ShowInTaskbar="False"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BoolToStrikethroughConverter x:Key="BoolToStrikethrough"/>
    </Window.Resources>

    <Border x:Name="OuterBorder" Background="#FFF9E6" CornerRadius="8" BorderBrush="#E0D5A0" BorderThickness="1"
            Margin="8" AllowDrop="True"
            PreviewDrop="TodoList_Drop" PreviewDragOver="TodoList_DragOver" PreviewDragLeave="TodoList_DragLeave">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3" Color="#888"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="#FFE8A0" CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               VerticalAlignment="Center"
                               FontSize="14" FontWeight="Bold" Foreground="#5A4E2F"
                               Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                               MouseLeftButtonDown="NameTextBlock_MouseLeftButtonDown"/>
                    <TextBox Grid.Column="0"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             FontSize="14" FontWeight="Bold" Foreground="#5A4E2F"
                             Background="White" BorderThickness="1" BorderBrush="#D0C580"
                             Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVisibility}}"
                             KeyDown="NameTextBox_KeyDown"
                             LostFocus="NameTextBox_LostFocus"
                             x:Name="NameEditBox"/>

                    <Button Grid.Column="1" Content="+" FontSize="16" Width="28" Height="28"
                            Margin="2,0" Background="Transparent" BorderThickness="0"
                            Foreground="#5A4E2F" Cursor="Hand"
                            Click="NewNoteButton_Click" ToolTip="新增便笺"/>

                    <Button Grid.Column="2" FontFamily="Segoe MDL2 Assets" Content="&#xE74D;"
                            FontSize="12" Width="28" Height="28"
                            Margin="2,0" Background="Transparent" BorderThickness="0"
                            Foreground="#C88" Cursor="Hand"
                            Click="DeleteButton_Click" ToolTip="删除便笺"/>

                    <Button Grid.Column="3" Content="&#x2715;" FontSize="12" Width="28" Height="28"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#C44" Cursor="Hand"
                            Click="CloseButton_Click" ToolTip="关闭窗口"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="8,4,8,4">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TodoAreaRow" Height="*" MinHeight="80"/>
                    <RowDefinition x:Name="SplitterRow" Height="5"/>
                    <RowDefinition x:Name="NoteAreaRow" Height="*" MinHeight="80"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Todos}"
                                      x:Name="TodoList"
                                      FocusVisualStyle="{x:Null}"
                                      PreviewMouseLeftButtonDown="TodoList_PreviewMouseLeftButtonDown"
                                      PreviewMouseLeftButtonUp="TodoList_PreviewMouseLeftButtonUp"
                                      PreviewMouseMove="TodoList_PreviewMouseMove">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}"
                                                  VerticalAlignment="Top" Margin="4,3,4,0"/>
                                        <Grid Grid.Column="1">
                                            <TextBlock Text="{Binding Content}" FontSize="13"
                                                       VerticalAlignment="Top" Margin="2,2,0,0" Padding="2,0,0,0"
                                                       TextWrapping="Wrap" MinHeight="24"
                                                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                                       MouseLeftButtonDown="TodoItem_MouseLeftButtonDown">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Foreground" Value="#AAA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox x:Name="TodoEditBox"
                                                     Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     FontSize="13" VerticalAlignment="Top"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     MinHeight="24" Margin="2,2,0,0"
                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                                     FocusVisualStyle="{x:Null}"
                                                     Loaded="TodoTextBox_Loaded"
                                                     PreviewKeyDown="TodoTextBox_PreviewKeyDown"
                                                     LostFocus="TodoTextBox_LostFocus">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Foreground" Value="#AAA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBlock Text="Enter换行，Ctrl+Enter继续新增"
                                                       FontSize="13" Foreground="#B0A890"
                                                       IsHitTestVisible="False"
                                                       Margin="6,3,0,0" VerticalAlignment="Top">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsEditing}" Value="True"/>
                                                                    <Condition Binding="{Binding Text, ElementName=TodoEditBox}" Value=""/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsEditing}" Value="True"/>
                                                                    <Condition Binding="{Binding Text, ElementName=TodoEditBox}" Value="{x:Null}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Button Grid.Column="2" Content="&#x2715;" FontSize="10"
                                                Width="20" Height="20" Background="Transparent"
                                                BorderThickness="0" Foreground="#C88" Cursor="Hand"
                                                VerticalAlignment="Top" Margin="0,1,0,0"
                                                Command="{Binding DataContext.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Opacity="0.5" ToolTip="删除待办"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ 新增待办" FontSize="13" Height="28"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#8B7D5E" Cursor="Hand"
                                Command="{Binding AddTodoCommand}"
                                ToolTip="新增待办" Margin="6,6,4,4"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <GridSplitter x:Name="Splitter" Grid.Row="1" HorizontalAlignment="Stretch" Height="5"
                              Background="#E0D5A0" ResizeBehavior="PreviousAndNext"
                              Opacity="0.6"
                              DragCompleted="Splitter_DragCompleted"
                              Visibility="{Binding IsNoteVisible, Converter={StaticResource BoolToVisibility}}"/>

                <DockPanel Grid.Row="2"
                           Visibility="{Binding IsNoteVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,4,4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <Button Content="B" FontWeight="Bold" FontSize="12" Width="24" Height="22"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#8B7D5E" Cursor="Hand"
                                    Command="{Binding ToggleBoldCommand}"
                                    ToolTip="粗体" VerticalAlignment="Center"/>
                            <Button Content="I" FontStyle="Italic" FontSize="12" Width="24" Height="22"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#8B7D5E" Cursor="Hand"
                                    Command="{Binding ToggleItalicCommand}"
                                    ToolTip="斜体" VerticalAlignment="Center"/>
                            <Button Content="U" FontSize="12" Width="24" Height="22"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#8B7D5E" Cursor="Hand"
                                    Command="{Binding ToggleUnderlineCommand}"
                                    ToolTip="下划线" VerticalAlignment="Center"/>
                            <Button Content="&#x2261;" FontSize="14" Width="24" Height="22"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#8B7D5E" Cursor="Hand"
                                    Command="{Binding ToggleBulletListCommand}"
                                    ToolTip="项目符号" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <RichTextBox x:Name="NoteEditor"
                                 BorderThickness="0"
                                 FontSize="13"
                                 Margin="4,0"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="NoteEditor_TextChanged"
                                 Loaded="NoteEditor_Loaded"/>
                </DockPanel>
            </Grid>

            <Border x:Name="BottomBarBorder" Grid.Row="2" Background="#FFF0C8" CornerRadius="0,0,8,8" Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" FontFamily="Segoe MDL2 Assets"
                            FontSize="12" Width="24" Height="22"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#8B7D5E" Cursor="Hand"
                            Command="{Binding ToggleNoteVisibilityCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="&#xE70D;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNoteVisible}" Value="False">
                                        <Setter Property="Content" Value="&#xE70E;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                x:Name="ColorSwatchPanel">
                        <Button Width="20" Height="20" Margin="2,0" Cursor="Hand"
                                Click="ColorSwatch_Click" Tag="Yellow" ToolTip="黄色">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Ellipse Fill="#FFE8A0" Width="18" Height="18"
                                             Stroke="#C0B070" StrokeThickness="1"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="20" Height="20" Margin="2,0" Cursor="Hand"
                                Click="ColorSwatch_Click" Tag="Blue" ToolTip="蓝色">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Ellipse Fill="#B8D9F0" Width="18" Height="18"
                                             Stroke="#90B0C8" StrokeThickness="1"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="20" Height="20" Margin="2,0" Cursor="Hand"
                                Click="ColorSwatch_Click" Tag="Pink" ToolTip="粉色">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Ellipse Fill="#F0B8C8" Width="18" Height="18"
                                             Stroke="#C890A0" StrokeThickness="1"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="20" Height="20" Margin="2,0" Cursor="Hand"
                                Click="ColorSwatch_Click" Tag="Green" ToolTip="绿色">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Ellipse Fill="#B8F0B8" Width="18" Height="18"
                                             Stroke="#90C890" StrokeThickness="1"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="20" Height="20" Margin="2,0" Cursor="Hand"
                                Click="ColorSwatch_Click" Tag="Gray" ToolTip="灰色">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Ellipse Fill="#D8D8D8" Width="18" Height="18"
                                             Stroke="#B0B0B0" StrokeThickness="1"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
