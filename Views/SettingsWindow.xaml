<Window x:Class="QuickNote.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickNote 设置"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Border Background="#FFF9E6" CornerRadius="8" BorderBrush="#E0D5A0" BorderThickness="1"
            Margin="8" MinWidth="320">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3" Color="#888"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#FFE8A0" CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="设置" FontSize="14" FontWeight="Bold"
                               Foreground="#5A4E2F" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="&#x2715;" FontSize="12" Width="28" Height="28"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#C44" Cursor="Hand" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="20,16,20,16">
                <!-- Auto-start -->
                <TextBlock Text="常规" FontSize="13" FontWeight="SemiBold" Foreground="#5A4E2F"
                           Margin="0,0,0,8"/>
                <CheckBox x:Name="AutoStartCheckBox" Content="开机自动启动"
                          FontSize="13" Foreground="#5A4E2F" Margin="4,0,0,16"
                          Checked="AutoStartCheckBox_Changed"
                          Unchecked="AutoStartCheckBox_Changed"/>
            </StackPanel>

            <!-- Bottom Buttons -->
            <Border Grid.Row="2" Background="#FFF0C8" CornerRadius="0,0,8,8" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="确定" FontSize="12" Padding="20,6" Margin="8,0"
                            Background="#FFE088" BorderThickness="1" BorderBrush="#E0C860"
                            Cursor="Hand" Click="SaveButton_Click" Foreground="#5A4E2F"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
